---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';

export async function getStaticPaths() {
  const people = await getCollection('alumni');
  return people.map((p) => ({ params: { slug: p.slug }, props: { person: p } }));
}
const { person } = Astro.props;
const { Content } = await person.render();
const d = person.data;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={d.name}>
  <section class="max-w-content mx-auto px-6 py-20">
    <a href={`${base}people/`} class="font-mono text-xs text-signal hover:underline">← All people</a>
    <div class="mt-8 grid md:grid-cols-[auto,1fr] gap-8 items-start" data-reveal>
      <Avatar name={d.name} photo={d.photo} size="lg" />
      <div>
        <h1 class="text-3xl">{d.name}</h1>
        <p class="text-slate-soft mt-1">{d.previous_position} · {d.research_period}</p>
        <div class="mt-4 flex flex-wrap gap-2">{d.research_area.map((a) => <span class="tag">{a}</span>)}</div>
        {(d.current_position || d.current_organization) && (
          <p class="mt-4 text-sm text-ink">
            Currently: <span class="font-medium">{d.current_position}</span>
            {d.current_organization && <> at {d.current_organization}</>}
          </p>
        )}
        {d.profile_link && <a href={d.profile_link} class="mt-2 inline-block font-mono text-xs text-signal hover:underline">Profile →</a>}
      </div>
    </div>

    <div class="prose prose-neutral max-w-2xl mt-10" data-reveal><Content /></div>

    {d.achievements.length > 0 && (
      <div class="mt-12 mb-4" data-reveal>
        <span class="section-label">Achievements</span>
        <ul class="mt-3 space-y-1 text-sm text-slate-soft list-disc pl-4">{d.achievements.map((a) => <li>{a}</li>)}</ul>
      </div>
    )}
  </section>
</BaseLayout>
