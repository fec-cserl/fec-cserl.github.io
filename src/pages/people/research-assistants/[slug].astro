---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';

export async function getStaticPaths() {
  const people = await getCollection('research-assistants');

  return people.map((p) => ({
    params: { slug: p.slug },
    props: { person: p }
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();

const d = person.data;
const base = import.meta.env.BASE_URL;


// Publications
const allPubs = await getCollection('publications');

const pubs = allPubs.filter((p) =>
  p.data.authors.some((a) =>
    a.includes(d.name) || d.name.includes(a)
  )
);


// Projects
const allProjects = await getCollection('projects');

const projects = allProjects.filter((p) =>
  p.data.research_assistants.includes(d.name)
);


// Profile Links
const links = [
  ['Portfolio', d.portfolio],
  ['Google Scholar', d.google_scholar],
  ['ORCID', d.orcid],
  ['ResearchGate', d.researchgate],
  ['GitHub', d.github],
  ['LinkedIn', d.linkedin],
  ['CV', d.cv],
].filter(([, v]) => v);

---

<BaseLayout title={d.name}>

<section class="max-w-content mx-auto px-6 py-20">

<a 
  href={`${base}people/`} 
  class="font-mono text-xs text-signal hover:underline">
  ← All people
</a>


<div 
  class="mt-8 grid md:grid-cols-[auto,1fr] gap-8 items-start"
  data-reveal>

  <Avatar 
    name={d.name} 
    photo={d.photo} 
    size="lg" 
  />


  <div>

    <h1 class="text-3xl">
      {d.name}
    </h1>


    <p class="text-slate-soft mt-1">
      {d.designation}
    </p>


    <p class="text-slate-soft text-sm">
      {d.department}
    </p>


    {d.supervisor && (
      <p class="text-slate-soft text-sm mt-2">
        Supervised by {d.supervisor}
      </p>
    )}


    <div class="mt-4 flex flex-wrap gap-2">
      {d.research_area.map((a) => (
        <span class="tag">{a}</span>
      ))}
    </div>


    {links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">

        {links.map(([label, href]) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-signal hover:underline">
            {label}
          </a>
        ))}

      </div>
    )}

  </div>

</div>



<div 
  class="prose prose-neutral max-w-2xl mt-10"
  data-reveal>
  <Content />
</div>





{d.research_interests.length > 0 && (
<div class="mt-12" data-reveal>

  <span class="section-label">
    Research Interests
  </span>

  <div class="flex flex-wrap gap-2 mt-3">

    {d.research_interests.map((r) => (
      <span class="tag">{r}</span>
    ))}

  </div>

</div>
)}






{d.skills.length > 0 && (
<div class="mt-12" data-reveal>

  <span class="section-label">
    Technical Skills
  </span>

  <div class="flex flex-wrap gap-2 mt-3">

    {d.skills.map((s) => (
      <span class="tag">{s}</span>
    ))}

  </div>

</div>
)}





{d.ongoing_research?.length > 0 && (
<div class="mt-12" data-reveal>

  <span class="section-label">
    Ongoing Research
  </span>

  <ul class="mt-3 space-y-2 text-sm text-slate-soft">

    {d.ongoing_research.map((r) => (
      <li>• {r}</li>
    ))}

  </ul>

</div>
)}





{d.education.length > 0 && (
<div class="mt-12" data-reveal>

  <span class="section-label">
    Education
  </span>

  <ul class="mt-3 space-y-2 text-sm text-slate-soft">

    {d.education.map((e) => (
      <li>{e}</li>
    ))}

  </ul>

</div>
)}







{projects.length > 0 && (
<div class="mt-12" data-reveal>

  <span class="section-label">
    Current Projects
  </span>


  <ul class="mt-3 space-y-3">

    {projects.map((p) => (
      <li class="border-b border-ink/10 pb-3">

        <p class="font-medium">
          {p.data.title}
        </p>

        <p class="text-sm text-slate-soft">
          {p.data.description}
        </p>

      </li>
    ))}

  </ul>

</div>
)}







{pubs.length > 0 && (
<div class="mt-12 mb-4" data-reveal>

  <span class="section-label">
    Publications
  </span>


  <ul class="mt-3 space-y-3">

    {pubs.map((p) => (
      <li class="border-b border-ink/10 pb-3">

        <p class="font-medium">
          {p.data.title}
        </p>

        <p class="text-xs text-slate-soft font-mono mt-1">
          {p.data.venue} · {p.data.year}
        </p>

      </li>
    ))}

  </ul>

</div>
)}


</section>

</BaseLayout>