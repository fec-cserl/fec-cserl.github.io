---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';

export async function getStaticPaths() {
  const people = await getCollection('research-assistants');
  return people.map((p) => ({ params: { slug: p.slug }, props: { person: p } }));
}
const { person } = Astro.props;
const { Content } = await person.render();
const d = person.data;
const base = import.meta.env.BASE_URL;

const allPubs = await getCollection('publications');
const allProjects = await getCollection('projects');
const pubs = allPubs.filter((p) => p.data.authors.includes(d.name));
const projects = allProjects.filter((p) => p.data.research_assistants.includes(d.name));

const links = [['GitHub', d.github], ['LinkedIn', d.linkedin], ['Website', d.website]].filter(([, v]) => v);
---
<BaseLayout title={d.name}>
  <section class="max-w-content mx-auto px-6 py-20">
    <a href={`${base}people/`} class="font-mono text-xs text-signal hover:underline">← All people</a>
    <div class="mt-8 grid md:grid-cols-[auto,1fr] gap-8 items-start" data-reveal>
      <Avatar name={d.name} photo={d.photo} size="lg" />
      <div>
        <h1 class="text-3xl">{d.name}</h1>
        <p class="text-slate-soft mt-1">{d.designation}</p>
        {d.supervisor && <p class="text-slate-soft text-sm">Supervised by {d.supervisor}</p>}
        <div class="mt-4 flex flex-wrap gap-2">{d.research_area.map((a) => <span class="tag">{a}</span>)}</div>
        {links.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">
            {links.map(([label, href]) => <a href={href} class="text-signal hover:underline">{label}</a>)}
          </div>
        )}
      </div>
    </div>

    <div class="prose prose-neutral max-w-2xl mt-10" data-reveal><Content /></div>

    {d.research_interests.length > 0 && (
      <div class="mt-12" data-reveal>
        <span class="section-label">Research interests</span>
        <div class="flex flex-wrap gap-2 mt-3">{d.research_interests.map((r) => <span class="tag">{r}</span>)}</div>
      </div>
    )}

    {projects.length > 0 && (
      <div class="mt-12" data-reveal>
        <span class="section-label">Current projects</span>
        <ul class="mt-3 space-y-3">{projects.map((p) => <li class="border-b border-ink/10 pb-3 font-medium">{p.data.title}</li>)}</ul>
      </div>
    )}

    {pubs.length > 0 && (
      <div class="mt-12 mb-4" data-reveal>
        <span class="section-label">Publications</span>
        <ul class="mt-3 space-y-3">
          {pubs.map((p) => (
            <li class="border-b border-ink/10 pb-3">
              <p class="font-medium">{p.data.title}</p>
              <p class="text-xs text-slate-soft font-mono mt-1">{p.data.venue} · {p.data.year}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>
