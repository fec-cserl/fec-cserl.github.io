---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
const c = site.contact;
---
<BaseLayout title="Contact">
  <section class="max-w-content mx-auto px-6 py-20 grid md:grid-cols-2 gap-14">
    <div data-reveal>
      <span class="section-label">Get in touch</span>
      <h1 class="text-4xl mb-6">Contact</h1>
      <p class="text-slate-soft leading-relaxed max-w-sm">{c.address}</p>
      <div class="mt-6 space-y-2 font-mono text-sm">
        <p>Email: <a href={`mailto:${c.email}`} class="text-signal hover:underline">{c.email}</a></p>
        <p>Phone: {c.phone}</p>
      </div>
    </div>
    <div data-reveal>
      {c.map_embed_url ? (
        <iframe src={c.map_embed_url} class="w-full h-72 border border-ink/10 rounded-md" loading="lazy"></iframe>
      ) : (
        <div class="w-full h-72 border border-dashed border-ink/20 rounded-md flex items-center justify-center text-slate-soft text-sm">
          Add a Google Maps embed URL in src/data/site.yaml → contact.map_embed_url
        </div>
      )}
    </div>
  </section>
</BaseLayout>
