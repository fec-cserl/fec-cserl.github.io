---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LabGallery from '../components/LabGallery.astro';
import HeroBackground from '../components/HeroBackground.astro';
import LabSpec from '../components/LabSpec.astro';
import CountUp from '../components/CountUp.astro';
import { site } from '../lib/site';

const base = import.meta.env.BASE_URL;

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const supervisors = await getCollection('supervisors');
const ras = (await getCollection('research-assistants')).filter((r) => r.data.designation === 'Research Assistant');
const juniorRas = (await getCollection('research-assistants')).filter((r) => r.data.designation === 'Junior Research Assistant');
const alumni = await getCollection('alumni');
const publications = await getCollection('publications');
const projects = await getCollection('projects');
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const events = (await getCollection('events')).filter((e) => e.data.upcoming).sort((a, b) => +a.data.date - +b.data.date);

const stats = [
  { label: 'Research Areas', value: research.length },
  { label: 'Supervisors', value: supervisors.length },
  { label: 'Research Assistants', value: ras.length },
  { label: 'Junior RAs', value: juniorRas.length },
  { label: 'Alumni', value: alumni.length },
  { label: 'Publications', value: publications.length },
];

const featuredAreas = research.filter((r) => r.data.featured);
const latestNews = news.slice(0, 3);
const ongoingProjects = projects.filter((p) => p.data.status === 'Ongoing').slice(0, 3);
const recentPubs = [...publications].sort((a, b) => b.data.year - a.data.year).slice(0, 3);
---
<BaseLayout title="Home">
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-ink/10 min-h-[560px] flex items-center">
    <HeroBackground />
    <div class="relative max-w-content mx-auto px-6 py-24 grid lg:grid-cols-[1.2fr,0.8fr] gap-14 items-center w-full">
      <div data-reveal>
        <span class="eyebrow">{site.hero.eyebrow}</span>
        <h1 class="mt-4 text-4xl md:text-5xl leading-[1.1] font-medium text-ink">
          {site.site_name}
        </h1>
        <p class="mt-6 text-slate-soft text-lg max-w-md leading-relaxed">
          {site.tagline}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {site.hero.buttons.map((b, i) => (
            <a
              href={`${base}${b.href.replace(/^\//, '')}`}
              class={i === 0 ? 'btn-primary' : 'btn-ghost'}
            >{b.label}</a>
          ))}
        </div>
      </div>
      <div data-reveal style="transition-delay:120ms">
        <LabSpec rows={[
          { label: 'Focus areas', value: String(research.length) },
          { label: 'Active projects', value: String(projects.filter((p) => p.data.status === 'Ongoing').length) },
          { label: 'Publications', value: String(publications.length) },
          { label: 'Status', value: 'Recruiting' },
        ]} />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-b border-ink/10 bg-paper-dim">
    <div class="max-w-content mx-auto px-6 py-14 grid grid-cols-2 md:grid-cols-6 gap-8 text-center">
      {stats.map((s) => <CountUp value={s.value} label={s.label} />)}
    </div>
  </section>

  <!-- INSIDE THE LAB -->
  <section class="max-w-content mx-auto px-6 py-24">
    <div data-reveal class="mb-10">
      <span class="section-label">A look inside</span>
      <h2 class="text-3xl">Inside the Lab</h2>
    </div>
    <LabGallery />
  </section>

  <!-- FEATURED RESEARCH AREAS -->
  <section class="max-w-content mx-auto px-6 py-24">
    <div data-reveal class="flex items-end justify-between mb-10">
      <div>
        <span class="section-label">What we study</span>
        <h2 class="text-3xl">Research Areas</h2>
      </div>
      <a href={`${base}research/`} class="hidden md:inline text-sm text-signal hover:underline">View all →</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredAreas.map((r) => (
        <a href={`${base}research/${r.data.area_slug}/`} class="card block" data-reveal>
          <p class="font-display text-xl mb-2">{r.data.title}</p>
          <p class="text-sm text-slate-soft leading-relaxed">{r.data.summary}</p>
          <span class="mt-4 inline-block text-xs text-signal">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST UPDATES -->
  <section class="max-w-content mx-auto px-6 pb-24 grid lg:grid-cols-3 gap-10">
    <div data-reveal>
      <span class="section-label">Latest publications</span>
      <ul class="space-y-5">
        {recentPubs.map((p) => (
          <li class="border-b border-ink/10 pb-4">
            <p class="font-medium text-ink leading-snug">{p.data.title}</p>
            <p class="text-xs text-slate-soft mt-1">{p.data.venue} · {p.data.year}</p>
          </li>
        ))}
      </ul>
      <a href={`${base}publications/`} class="mt-4 inline-block text-xs text-signal hover:underline">All publications →</a>
    </div>

    <div data-reveal>
      <span class="section-label">Current projects</span>
      <ul class="space-y-5">
        {ongoingProjects.map((p) => (
          <li class="border-b border-ink/10 pb-4">
            <p class="font-medium text-ink leading-snug">{p.data.title}</p>
            <p class="text-xs text-slate-soft mt-1">{p.data.description.slice(0, 80)}...</p>
          </li>
        ))}
      </ul>
      <a href={`${base}projects/`} class="mt-4 inline-block text-xs text-signal hover:underline">All projects →</a>
    </div>

    <div data-reveal>
      <span class="section-label">News &amp; events</span>
      <ul class="space-y-5">
        {latestNews.map((n) => (
          <li class="border-b border-ink/10 pb-4">
            <p class="font-medium text-ink leading-snug">{n.data.title}</p>
            <p class="text-xs text-slate-soft mt-1">{n.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
          </li>
        ))}
      </ul>
      <a href={`${base}news/`} class="mt-4 inline-block text-xs text-signal hover:underline">All news →</a>
    </div>
  </section>
</BaseLayout>
