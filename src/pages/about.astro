---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { site } from '../lib/site';
const d = site.about.director;
---
<BaseLayout title="About">
  <section class="max-w-content mx-auto px-6 py-20">
    <span class="section-label" data-reveal>Who we are</span>
    <h1 class="text-4xl mb-8" data-reveal>{site.about.heading}</h1>
    <p class="max-w-2xl text-lg text-slate-soft leading-relaxed" data-reveal>{site.about.body}</p>

    <div class="mt-16 grid md:grid-cols-2 gap-8">
      <div class="card" data-reveal>
        <span class="tag mb-4 inline-block">Mission</span>
        <p class="text-ink leading-relaxed">{site.about.mission}</p>
      </div>
      <div class="card" data-reveal>
        <span class="tag mb-4 inline-block">Vision</span>
        <p class="text-ink leading-relaxed">{site.about.vision}</p>
      </div>
    </div>

    <!-- DIRECTOR'S MESSAGE -->
    <div class="mt-20" data-reveal>
      <span class="section-label">A message from the director</span>
      <div class="card !p-10 grid md:grid-cols-[auto,1fr] gap-8 md:gap-10 items-start">
        <div class="flex md:block items-center gap-4">
          <Avatar name={d.name} photo={d.photo} size="xl" />
        </div>
        <div>
          <svg class="text-signal/25 mb-2" width="34" height="26" viewBox="0 0 34 26" fill="currentColor" aria-hidden="true">
            <path d="M0 26V15.6C0 10.2 1.5 6.2 4.6 3.5 6.5 1.7 9 .5 12 0l1.4 4.3c-2.5.7-4.3 1.9-5.4 3.5-1 1.5-1.5 3.1-1.5 4.8h6.7V26H0Zm18.6 0V15.6c0-5.4 1.5-9.4 4.6-12.1C25.1 1.7 27.6.5 30.6 0L32 4.3c-2.5.7-4.3 1.9-5.4 3.5-1 1.5-1.5 3.1-1.5 4.8h6.7V26H18.6Z"/>
          </svg>
          <p class="text-ink text-lg leading-relaxed whitespace-pre-line max-w-2xl">{d.message}</p>
          <p class="mt-6 font-display text-xl">{d.name}</p>
          <p class="text-sm text-slate-soft">{d.designation}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
