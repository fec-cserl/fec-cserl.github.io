---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
---
<BaseLayout title="Projects">
  <section class="max-w-content mx-auto px-6 py-20">
    <span class="section-label" data-reveal>What we're building</span>
    <h1 class="text-4xl mb-10" data-reveal>Projects</h1>
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((p) => (
        <div class="card" data-reveal>
          <div class="flex items-center justify-between mb-2">
            <p class="font-display text-xl">{p.data.title}</p>
            <span class="tag">{p.data.status}</span>
          </div>
          <p class="text-sm text-slate-soft leading-relaxed">{p.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">{p.data.research_area.map((a) => <span class="tag">{a}</span>)}</div>
          {p.data.supervisor && <p class="mt-3 text-xs text-slate-soft">Supervisor: {p.data.supervisor}</p>}
          {p.data.research_assistants.length > 0 && (
            <p class="text-xs text-slate-soft">RAs: {p.data.research_assistants.join(', ')}</p>
          )}
          <div class="mt-3 flex flex-wrap gap-4 font-mono text-xs">
            {p.data.github && <a href={p.data.github} class="text-signal hover:underline">GitHub</a>}
            {p.data.demo && <a href={p.data.demo} class="text-signal hover:underline">Demo</a>}
            {p.data.paper && <a href={p.data.paper} class="text-signal hover:underline">Paper</a>}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
