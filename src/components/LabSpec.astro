---
// Signature hero element: the lab presented like a datasheet entry rather
// than a marketing graphic — field/value rows, set in mono, the way a
// research group might document itself internally.
interface Props {
  rows: { label: string; value: string }[];
}
const { rows } = Astro.props;
---
<div class="border border-ink/15 bg-white">
  <div class="flex items-center justify-between px-5 py-3 border-b border-ink/15">
    <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-slate-soft">Lab record</span>
    <span class="w-1.5 h-1.5 rounded-full bg-signal"></span>
  </div>
  <dl>
    {rows.map((r, i) => (
      <div class:list={["flex items-start justify-between gap-6 px-5 py-3.5", i !== rows.length - 1 && "border-b border-ink/10"]}>
        <dt class="text-[11px] font-mono uppercase tracking-wide text-slate-soft pt-0.5">{r.label}</dt>
        <dd class="text-sm text-ink text-right font-medium">{r.value}</dd>
      </div>
    ))}
  </dl>
</div>
