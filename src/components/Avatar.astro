---
interface Props { name: string; photo?: string; size?: 'sm' | 'md' | 'lg' | 'xl' }
const { name, photo, size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = photo ? `${base}${photo.replace(/^\//, '')}` : undefined;
const initials = name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const dims = { sm: 'w-12 h-12 text-sm', md: 'w-20 h-20 text-lg', lg: 'w-28 h-28 text-2xl', xl: 'w-36 h-36 text-3xl' }[size];
// a stable, name-derived hue offset so placeholders differ gently from person
// to person instead of all looking identical
const hue = name.split('').reduce((a, c) => a + c.charCodeAt(0), 0) % 18;
---
{src ? (
  <img src={src} alt={name} class={`${dims} rounded-full object-cover border border-ink/10 shrink-0`} />
) : (
  <div
    class={`${dims} rounded-full text-white font-display flex items-center justify-center shrink-0 ring-4 ring-white shadow-sm`}
    style={`background: linear-gradient(150deg, hsl(${150 + hue} 28% 34%), hsl(${150 + hue} 32% 20%));`}
  >
    {initials}
  </div>
)}
