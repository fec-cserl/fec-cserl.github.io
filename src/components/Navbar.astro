---
import { site } from '../lib/site';

const base = import.meta.env.BASE_URL;
const nav = [
  ['Home', ''],
  ['About', 'about'],
  ['Research', 'research'],
  ['People', 'people'],
  ['Publications', 'publications'],
  ['Projects', 'projects'],
  ['News', 'news'],
  ['Events', 'events'],
  ['Join Us', 'join'],
  ['Contact', 'contact'],
];
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '');
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-sm">
  <div class="max-w-content mx-auto px-6 flex items-center justify-between h-16">
    <a href={base} class="font-display text-lg text-ink tracking-tight">
      {site.site_short_name}
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-[14px]">
      {nav.map(([label, href]) => {
        const active = path === href;
        return (
          <a
            href={`${base}${href}${href ? '/' : ''}`}
            class:list={[
              'px-3 py-2 rounded-md transition-colors',
              active ? 'text-signal font-medium' : 'text-slate hover:text-ink',
            ]}
          >{label}</a>
        );
      })}
    </nav>

    <button id="menu-btn" class="lg:hidden text-ink" aria-label="Open menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M3 6h18M3 12h18M3 18h18"/>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-ink/10 bg-paper px-6 py-4 flex flex-col gap-1 text-sm">
    {nav.map(([label, href]) => (
      <a href={`${base}${href}${href ? '/' : ''}`} class="py-2 text-slate hover:text-signal">{label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
