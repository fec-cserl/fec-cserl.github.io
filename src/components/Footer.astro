---
import { site } from '../lib/site';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="border-t border-ink/10 bg-paper-dim mt-32">
  <div class="max-w-content mx-auto px-6 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-display text-xl text-ink">{site.site_short_name}</p>
      <p class="mt-3 text-sm leading-relaxed max-w-xs text-slate-soft">{site.tagline}</p>
    </div>
    <div class="text-sm">
      <p class="text-ink font-medium mb-3">Explore</p>
      <ul class="space-y-2 text-slate-soft">
        <li><a href={`${base}research/`} class="hover:text-signal">Research</a></li>
        <li><a href={`${base}people/`} class="hover:text-signal">People</a></li>
        <li><a href={`${base}publications/`} class="hover:text-signal">Publications</a></li>
        <li><a href={`${base}join/`} class="hover:text-signal">Join Us</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="text-ink font-medium mb-3">Connect</p>
      <ul class="space-y-2 text-slate-soft">
        {site.footer.socials.map((s) => (
          <li><a href={s.href} class="hover:text-signal">{s.label}</a></li>
        ))}
        <li><a href={`${base}contact/`} class="hover:text-signal">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink/10 py-6 text-center text-xs text-slate-soft">
    © {year} {site.site_name}. Built with Astro & Tailwind.
  </div>
</footer>
