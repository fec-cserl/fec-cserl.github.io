---
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../lib/site';

const base = import.meta.env.BASE_URL;
const filename = site.hero.background_image;
const abs = path.resolve('./public/images/lab', filename);
const exists = fs.existsSync(abs);
---
{exists ? (
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image:url(${base}images/lab/${filename})`}
  ></div>
) : (
  <div class="absolute inset-0 hero-grid-bg"></div>
)}
<div class="absolute inset-0 bg-gradient-to-b from-paper/30 via-paper/70 to-paper"></div>

<style>
  /* quiet ruled-paper grid instead of a gradient/blob backdrop */
  .hero-grid-bg {
    background-color: #F4F5F1;
    background-image:
      linear-gradient(#1C1F1D0d 1px, transparent 1px),
      linear-gradient(90deg, #1C1F1D0d 1px, transparent 1px);
    background-size: 42px 42px;
  }
</style>
